# [공시 분류 규칙]
KEYWORD_TYPE_RULES = {
    'A': ['사업보고서', '분기보고서', '반기보고서'],
    'B': ['주요사항보고서', '유상증자결정', '무상증자결정', '합병', '영업양수'],
    'C': ['증권신고서', '투자설명서', '채권발행', '사채발행', '발행공고'],
    'D': ['주식등의대량보유상황보고서', '최대주주변경', '임원ㆍ주요주주특정증권'],
    'I': ['안내공시', '거래소공시', '수시공시', '공정공시'],
    'J': ['대규모내부거래', '기업집단현황']
