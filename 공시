import requests
import time
import ssl
import warnings
import zipfile
import io
import xml.etree.ElementTree as ET
import threading
import webbrowser
import queue
import os
import tkinter as tk
from tkinter import ttk, messagebox
from datetime import datetime
from plyer import notification

warnings.filterwarnings(action='ignore')
ssl_verify = False
API_KEY = '88334205f08b12dbc563a46758a3534a1778f471'
DART_VIEW_URL = "https://dart.fss.or.kr/dsaf001/main.do?rcpNo="

# 로컬 저장 파일명
EXCLUDE_FILE = "exclude_keywords.txt"
INCLUDE_FILE = "include_keywords.txt"

PBLNTF_TY_MAP = {
    'A': '정기공시', 'B': '주요사항보고', 'C': '발행공시', 'D': '지분공시',
    'E': '기타공시', 'F': '외부감사관련', 'G': '펀드공시', 'H': '자산유동화',
    'I': '거래소공시', 'J': '공정위공시'
}

class DartMonitorApp:
    def __init__(self, root):
        self.root = root
        self.root.title("DART 실시간 모니터 v3.6 (키워드 필터 강화)")
        self.root.geometry("1200x800")
        
        self.processed_ids = set()
        self.is_running = False
        self.update_queue = queue.Queue()
        
        # 키워드 로드
        self.exclude_keywords = self.load_keywords(EXCLUDE_FILE)
        self.include_keywords = self.load_keywords(INCLUDE_FILE)
        self.all_market_corps = self.get_all_market_corps()
        
        self.setup_ui()
        self.process_queue()

    def load_keywords(self, filename):
        if os.path.exists(filename):
            with open(filename, 'r', encoding='utf-8') as f:
                return [line.strip() for line in f.readlines() if line.strip()]
        return []

    def save_keywords(self, filename, kws):
        with open(filename, 'w', encoding='utf-8') as f:
            for kw in kws: f.write(kw + "\n")

    def get_all_market_corps(self):
        try:
            url = "https://opendart.fss.or.kr/api/corpCode.xml"
            res = requests.get(url, params={'crtfc_key': API_KEY}, verify=ssl_verify)
            with zipfile.ZipFile(io.BytesIO(res.content)) as z:
                xml_data = z.read('CORPCODE.xml')
            tree = ET.fromstring(xml_data)
            return {row.find('corp_name').text for row in tree.findall('list') if row.find('stock_code').text.strip()}
        except: return set()

    def setup_ui(self):
        # 상단 설정창
        top = tk.Frame(self.root, pady=10)
        top.pack(fill="x")
        tk.Label(top, text="조회 주기(초): ").pack(side="left", padx=5)
        self.interval_entry = tk.Entry(top, width=5)
        self.interval_entry.insert(0, "60")
        self.interval_entry.pack(side="left", padx=5)
        
        self.monitor_mode = tk.StringVar(value="all")
        tk.Radiobutton(top, text="전체 상장사", variable=self.monitor_mode, value="all").pack(side="left", padx=10)
        tk.Radiobutton(top, text="관심 종목", variable=self.monitor_mode, value="selected").pack(side="left", padx=10)

        # 메인 레이아웃
        paned = tk.PanedWindow(self.root, orient="horizontal")
        paned.pack(fill="both", expand=True, padx=10, pady=5)

        # 1. 좌측: 관심 종목
        left = tk.LabelFrame(paned, text="관심 종목")
        paned.add(left, width=150)
        self.corp_vars = {}
        for c in ['삼성전자', 'SK하이닉스', '현대차', 'NAVER', '카카오']:
            v = tk.BooleanVar()
            tk.Checkbutton(left, text=c, variable=v).pack(anchor="w")
            self.corp_vars[c] = v

        # 2. 중앙: 리스트
        center = tk.LabelFrame(paned, text="공시 목록 (더블클릭 시 열기)")
        paned.add(center, width=600)
        self.tree = ttk.Treeview(center, columns=("t","y","c","r"), show='headings')
        for col, head in zip(("t","y","c","r"), ("시간","유형","종목","제목")):
            self.tree.heading(col, text=head)
        self.tree.column("t", width=70); self.tree.column("y", width=90); self.tree.column("c", width=100)
        self.tree.pack(fill="both", expand=True)
        self.tree.bind("<Double-1>", lambda e: webbrowser.open(self.tree.item(self.tree.selection()[0], "tags")[0]))

        # 3. 우측: 키워드 필터
        right = tk.Frame(paned)
        paned.add(right, width=250)

        # 포함 키워드 UI
        inc_f = tk.LabelFrame(right, text="포함 키워드 (있을 때만 표시)")
        inc_f.pack(fill="both", expand=True, pady=2)
        self.inc_ent = tk.Entry(inc_f)
        self.inc_ent.pack(fill="x"); self.inc_ent.bind("<Return>", self.add_inc)
        self.inc_lb = tk.Listbox(inc_f, height=8)
        self.inc_lb.pack(fill="both", expand=True); self.inc_lb.bind("<Delete>", self.del_inc)
        for k in self.include_keywords: self.inc_lb.insert(tk.END, k)

        # 제외 키워드 UI
        exc_f = tk.LabelFrame(right, text="제외 키워드 (무조건 차단)")
        exc_f.pack(fill="both", expand=True, pady=2)
        self.exc_ent = tk.Entry(exc_f)
        self.exc_ent.pack(fill="x"); self.exc_ent.bind("<Return>", self.add_exc)
        self.exc_lb = tk.Listbox(exc_f, height=8)
        self.exc_lb.pack(fill="both", expand=True); self.exc_lb.bind("<Delete>", self.del_exc)
        for k in self.exclude_keywords: self.exc_lb.insert(tk.END, k)

        # 하단 제어
        self.btn_txt = tk.StringVar(value="모니터링 시작")
        self.start_btn = tk.Button(self.root, textvariable=self.btn_txt, command=self.toggle, bg="#2ecc71", fg="white", font=('',12,'bold'), height=2)
        self.start_btn.pack(fill="x", padx=10, pady=5)
        self.status = tk.Label(self.root, text="대기 중", fg="gray")
        self.status.pack()

    def add_inc(self, e):
        k = self.inc_ent.get().strip()
        if k and k not in self.include_keywords:
            self.include_keywords.append(k); self.inc_lb.insert(tk.END, k)
            self.save_keywords(INCLUDE_FILE, self.include_keywords); self.inc_ent.delete(0, tk.END)

    def del_inc(self, e):
        s = self.inc_lb.curselection()
        if s:
            k = self.inc_lb.get(s[0]); self.include_keywords.remove(k)
            self.inc_lb.delete(s[0]); self.save_keywords(INCLUDE_FILE, self.include_keywords)

    def add_exc(self, e):
        k = self.exc_ent.get().strip()
        if k and k not in self.exclude_keywords:
            self.exclude_keywords.append(k); self.exc_lb.insert(tk.END, k)
            self.save_keywords(EXCLUDE_FILE, self.exclude_keywords); self.exc_ent.delete(0, tk.END)

    def del_exc(self, e):
        s = self.exc_lb.curselection()
        if s:
            k = self.exc_lb.get(s[0]); self.exclude_keywords.remove(k)
            self.exc_lb.delete(s[0]); self.save_keywords(EXCLUDE_FILE, self.exclude_keywords)

    def process_queue(self):
        """메인 루프에서만 UI 업데이트와 알림창 호출 (에러 방지 핵심)"""
        try:
            while True:
                d = self.update_queue.get_nowait()
                self.tree.insert("", 0, values=(d['t'], d['y'], d['c'], d['r']), tags=(d['u'],))
                # 알림창 호출을 메인스레드인 여기서만 수행
                notification.notify(title=f"DART [{d['c']}]", message=d['r'], timeout=5)
        except queue.Empty: pass
        self.root.after(200, self.process_queue)

    def toggle(self):
        if not self.is_running:
            self.start_time = datetime.now().strftime('%Y%m%d%H%M%S')
            self.is_running = True
            self.btn_txt.set("모니터링 중지")
            self.start_btn.config(bg="#e74c3c")
            threading.Thread(target=self.run_loop, daemon=True).start()
        else:
            self.is_running = False
            self.btn_txt.set("모니터링 시작")
            self.start_btn.config(bg="#2ecc71")

    def run_loop(self):
        while self.is_running:
            self.check()
            itv = int(self.interval_entry.get())
            for _ in range(itv):
                if not self.is_running: return
                time.sleep(1)

    def check(self):
        url = "https://opendart.fss.or.kr/api/list.json"
        params = {'crtfc_key': API_KEY, 'bgn_de': datetime.now().strftime('%Y%m%d'), 'page_count': '100', 'sort_mth': 'desc'}
        try:
            res = requests.get(url, params=params, verify=ssl_verify).json()
            if res.get('status') == '000':
                for item in res.get('list', []):
                    rid = item['rcept_no']
                    if rid in self.processed_ids or rid[:14] < self.start_time: continue
                    
                    title = item['report_nm']
                    # 1. 제외 키워드 필터 (무조건 제외)
                    if any(x in title for x in self.exclude_keywords): continue
                    
                    # 2. 포함 키워드 필터 (있을 때만 작동)
                    if self.include_keywords:
                        if not any(x in title for x in self.include_keywords): continue

                    # 3. 모드 필터
                    corp = item['corp_name']
                    if self.monitor_mode.get() == "all":
                        if corp not in self.all_market_corps: continue
                    else:
                        if not (self.corp_vars.get(corp) and self.corp_vars[corp].get()): continue

                    self.update_queue.put({
                        't': datetime.now().strftime('%H:%M:%S'),
                        'y': PBLNTF_TY_MAP.get(item.get('pblntf_ty'), '기타'),
                        'c': corp, 'r': title, 'u': DART_VIEW_URL + rid
                    })
                    self.processed_ids.add(rid)
        except: pass

if __name__ == "__main__":
    root = tk.Tk()
    app = DartMonitorApp(root)
    root.mainloop()
